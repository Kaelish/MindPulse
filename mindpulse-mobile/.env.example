# MindPulse mobile environment (copy to .env — .env is gitignored)

# Base URL of the MindPulse Django backend that serves the emotion model.
# Pick the value for how you are running the app:
#   Web / iOS simulator : http://localhost:8000
#   Android emulator    : http://10.0.2.2:8000
#   Physical phone      : http://<your-computer-LAN-IP>:8000  (same Wi-Fi)
#     e.g. EXPO_PUBLIC_MINDPULSE_API_URL=http://192.168.1.10:8000
# dev.ps1 writes the current computer LAN address if this is left blank.
EXPO_PUBLIC_MINDPULSE_API_URL=

# Daily.co video calling (optional, see services/video.ts)
# EXPO_PUBLIC_DAILY_BASE_URL=
# EXPO_PUBLIC_DAILY_TOKEN=
