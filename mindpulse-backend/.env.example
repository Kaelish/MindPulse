# MindPulse Django backend environment (copy to .env — never committed)

# Supabase service-role credentials: server-side only, bypasses RLS.
SUPABASE_URL=https://whihfwcygbqpjtrpnlck.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Django settings (see mindpulse_api/settings.py)
# DJANGO_SECRET_KEY is generated per run when DEBUG is on; set it explicitly
# for anything beyond local development.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOW_ALL=True
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
